}

#header .primary {
  background: #570a0a;
  box-shadow: none;
}

#greeting img.icon {
  border: 1px solid #9c0000;
  border-radius: 5px;
  background: #400f0f;
}

#greeting .menu {
  width: 12em !important;
}

#header .menu {
  width: 20em;
}

#header #search .button,
#header #search .submit {
  display: none;
}

#header #search .text {
  background: #400404;
  color: #000;
  width: 6em;
  border: 1px solid #fc9f9f;
}

form.search input[type="text"] {
  box-shadow: none;
}

.search [role="tooltip"] {
  background: #702020;
